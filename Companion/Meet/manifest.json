{
  "manifest_version": 3,
  "name": "MurMur Meet Companion",
  "version": "0.1.0",
  "description": "Share participant names and speaking activity with your local MurMur call. No audio, transcript, or meeting content is sent.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
